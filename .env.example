# Copy to .env and fill in. .env is never committed.
# No value may hold a bare $: the justfile loads this file with `set dotenv-load`,
# whose parser expands $name and leaves nothing where the name is undefined, so
# every recipe would see a truncated value while Python sees the whole one. Wrap
# such a value in single quotes — double quotes make just refuse the file outright.
# Django's get_random_secret_key() draws from a charset holding $, so generate the
# key alphanumeric instead:
#   uv run python -c "import secrets, string; print(''.join(secrets.choice(string.ascii_letters + string.digits) for _ in range(64)))"
SECRET_KEY=change-me
# dev | prod | test. Keep comments on their own line: django-environ reads a
# trailing "# ..." as part of the value, and an unrecognised value leaves the
# settings on no branch at all — no DATABASES, and a crash at the first query.
ENVIRONMENT=dev
# only ever True locally
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Where the site answers from, scheme included and no trailing slash. Every
# link in an outgoing mail is built on it, and prod refuses to start without it.
SITE_BASE_URL=http://localhost:8000

# Database (prod)
DATABASE_URL=
DATABASE_CONN_MAX_AGE=600
DATABASE_SSL_REQUIRE=True

# Email (dev: a local catcher such as mailpit on 1025)
EMAIL_HOST=localhost
EMAIL_PORT=1025

# Email (prod, Mailgun via Anymail)
MAILGUN_API_KEY=
MAILGUN_API_URL=https://api.eu.mailgun.net/v3
MAILGUN_SENDER_DOMAIN=
DEFAULT_FROM_EMAIL=noreply@example.com

# Google sign-in (optional: leave empty to hide the button)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Background tasks
TEST_WORKERS=4
Q_CLUSTER_WORKERS=4
Q_CLUSTER_TIMEOUT=300
Q_CLUSTER_RETRY=600
Q_CLUSTER_MAX_ATTEMPTS=3
Q_CLUSTER_QUEUE_LIMIT=50
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# A managed Redis is password-protected; leave empty for a bare local one
REDIS_PASSWORD=

# Media. Uploads live on a volume mounted at MEDIA_ROOT and are served by
# WhiteNoise; `manage.py check --deploy` fails when that volume is missing.
# Files nothing references any more are deleted by the daily sweep, sparing
# anything written in the last few hours.
MEDIA_ORPHAN_GRACE_HOURS=6

# Backups (db + media). Local disk unless a bucket is given here — and a bucket
# is the point: a volume dies with the machine it is attached to. Any
# S3-compatible endpoint works, a self-hosted MinIO included.
BACKUP_RETENTION_DAYS=30
BACKUP_BUCKET_NAME=
BACKUP_ENDPOINT_URL=
BACKUP_REGION=auto
BACKUP_ACCESS_KEY=
BACKUP_SECRET_KEY=
BACKUP_PREFIX=openseat

# Draft public forms: reminder after this long, deletion after this many days
INTAKE_DRAFT_REMINDER_HOURS=24
INTAKE_DRAFT_EXPIRY_DAYS=30

# Unconfirmed bookings: deletion this many days after the event
EVENTS_BOOKING_SWEEP_DAYS=30

# The manage link mailed from the Bookings card: how long it lasts, and how
# often one address may ask for it
EVENTS_BOOKING_LINK_DAYS=7
EVENTS_BOOKING_LINK_THROTTLE_SECONDS=300

# Cache database on the Redis instance, kept apart from the task queue's db 0
REDIS_CACHE_DB=1

# Security (prod defaults are already secure; override only to debug)
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
