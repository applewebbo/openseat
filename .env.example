# Copy to .env and fill in. .env is never committed.
SECRET_KEY=change-me
ENVIRONMENT=dev            # dev | prod | test
DEBUG=True                 # only ever True locally
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (prod)
DATABASE_URL=
DATABASE_CONN_MAX_AGE=600
DATABASE_SSL_REQUIRE=True

# Email (dev: a local catcher such as mailpit on 1025)
EMAIL_HOST=localhost
EMAIL_PORT=1025

# Email (prod, Mailgun via Anymail)
MAILGUN_API_KEY=
MAILGUN_API_URL=https://api.eu.mailgun.net/v3
MAILGUN_SENDER_DOMAIN=
DEFAULT_FROM_EMAIL=noreply@example.com

# Google sign-in (optional: leave empty to hide the button)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Background tasks
TEST_WORKERS=4
Q_CLUSTER_WORKERS=4
Q_CLUSTER_TIMEOUT=300
Q_CLUSTER_RETRY=600
Q_CLUSTER_MAX_ATTEMPTS=3
Q_CLUSTER_QUEUE_LIMIT=50
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Media storage (prod). WhiteNoise serves static only, so uploads need a home
# that survives a redeploy. Any S3-compatible provider works through
# MEDIA_ENDPOINT_URL: AWS S3, Cloudflare R2, Backblaze B2, Hetzner, or a MinIO
# you host yourself — the last one keeps the files on your own machine.
# The bucket must allow public reads: logos appear on public pages and in email.
# Set MEDIA_STORAGE=local instead only if this install mounts a volume at
# MEDIA_ROOT; leaving both unset makes the app refuse to start.
MEDIA_STORAGE=
MEDIA_BUCKET_NAME=
MEDIA_ENDPOINT_URL=
MEDIA_REGION=auto
MEDIA_ACCESS_KEY=
MEDIA_SECRET_KEY=
MEDIA_CUSTOM_DOMAIN=

# Draft public forms: reminder after this long, deletion after this many days
INTAKE_DRAFT_REMINDER_HOURS=24
INTAKE_DRAFT_EXPIRY_DAYS=30

# Security (prod defaults are already secure; override only to debug)
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
